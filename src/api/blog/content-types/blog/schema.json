{
  "kind": "collectionType",
  "collectionName": "blogs",
  "info": {
    "singularName": "blog",
    "pluralName": "blogs",
    "displayName": "blog",
    "description": ""
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string"
    },
    "slug": {
      "type": "string",
      "unique": true
    },
    "markdown": {
      "type": "richtext"
    },
    "locales": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::locale.locale",
      "mappedBy": "blog"
    },
    "tags": {
      "type": "text",
      "default": "- ",
      "regex": "^- .*(?:\\n- .*|(?!\\n-).)*$"
    },
    "branches": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::branch.branch",
      "mappedBy": "blog"
    }
  }
}
